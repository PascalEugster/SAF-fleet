# Copy this file to ".env" and fill in the values.
#
#   cp .env.example .env
#
# DATABASE_URI — where the local SQLite database file is stored.
# The default keeps it inside the project folder. No database server needed.
DATABASE_URI=file:./saf-fleet.db

# PAYLOAD_SECRET — a long random string used to sign login sessions.
# Generate one with:   openssl rand -hex 32
# Keep this private and never share or commit your real .env file.
PAYLOAD_SECRET=replace-with-a-long-random-string
